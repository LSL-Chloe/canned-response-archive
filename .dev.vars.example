# Example ONLY. NEVER commit a real .dev.vars, an OTP credential, or a Supabase secret.
# Copy to .dev.vars locally; use Cloudflare Worker Secrets in deployed environments.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_ONLY_KEY
# Generate using `openssl rand -hex 32`; treat as a permanent secret used for PIN hashes and rate-limit keys.
PIN_PEPPER=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Gmail Apps Script OTP sender (configure only once Gmail setup is authorized).
# OTP_MAILER_URL=https://script.google.com/macros/s/EXAMPLE/exec
# OTP_MAILER_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Optional: TMDB API Read Access Token for movie cast avatar search.
# TMDB_READ_ACCESS_TOKEN=your_token_here

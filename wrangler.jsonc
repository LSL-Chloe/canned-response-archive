{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "canned-response-archive",
  "compatibility_date": "2026-11-19",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "previews": {},
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
